# Student Notes Sharing System - Environment Variables

# Flask Settings
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=college-mini-project-secret-key-2026

# Database Configuration (MySQL / Amazon RDS)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=student_notes
DB_USER=root
DB_PASSWORD=your_password

# AWS S3 Configuration
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-bucket-name

# AWS Credentials (For local Windows testing. On AWS EC2, leave empty to use IAM Role!)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Storage Mode Toggle:
# Set to 'true' for local laptop development without AWS S3 credentials.
# Set to 'false' (or leave unset when AWS keys are configured) to use real Amazon S3.
USE_LOCAL_STORAGE=false
